<?xml version="1.0" encoding="utf-8"?>
<!-- Spatch's 4x2 home-screen widget. The ids are Spotify's own (their names are reused, see src/resources.rs) or the
     framework's, so the patch needs no new id resources. The backdrop, colours, cover and icons are drawn at run
     time from the playing cover (SpatchWidget). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF15161C">

    <ImageView
        android:id="@android:id/icon"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <ImageView
            android:id="@+id/coverart"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:scaleType="fitCenter"
            android:src="#2EFFFFFF" />

        <LinearLayout
            android:id="@+id/texts"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="14dp">

            <TextView
                android:id="@android:id/text1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.18"
                android:maxLines="1"
                android:text="SPATCH"
                android:textColor="#FF9DB7FF"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Spatch"
                android:textColor="#FFFFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Nothing playing"
                android:textColor="#B3FFFFFF"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/controls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btn_prev_normal"
                    android:src="@android:drawable/ic_media_previous"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:scaleType="fitCenter" />

                <ImageView
                    android:id="@+id/btn_play_normal"
                    android:src="@android:drawable/ic_media_play"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:scaleType="fitCenter" />

                <ImageView
                    android:id="@+id/btn_pause_normal"
                    android:src="@android:drawable/ic_media_pause"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/btn_next_normal"
                    android:src="@android:drawable/ic_media_next"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:scaleType="fitCenter" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
