<?xml version="1.0" encoding="utf-8"?>
<!-- Spatch's 4x1 home-screen widget: cover, title and artist, and the three controls in one row. Same ids and the
     same run-time drawing as the 4x2 layout (SpatchWidget). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF15161C">

    <ImageView
        android:id="@android:id/icon"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="10dp">

        <ImageView
            android:id="@+id/coverart"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:scaleType="fitCenter"
            android:src="#2EFFFFFF" />

        <LinearLayout
            android:id="@+id/texts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="6dp">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Spatch"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Nothing playing"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_prev_normal"
            android:src="@android:drawable/ic_media_previous"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:scaleType="fitCenter" />

        <ImageView
            android:id="@+id/btn_play_normal"
            android:src="@android:drawable/ic_media_play"
            android:layout_width="56dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:scaleType="fitCenter" />

        <ImageView
            android:id="@+id/btn_pause_normal"
            android:src="@android:drawable/ic_media_pause"
            android:layout_width="56dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/btn_next_normal"
            android:src="@android:drawable/ic_media_next"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:scaleType="fitCenter" />
    </LinearLayout>
</FrameLayout>
