<?xml version="1.0" encoding="utf-8"?>
<!-- Spatch widget for a tall space: the cover on top, then the title, then the controls. Same ids as spatch_widget; the cover's side is set at run time (SpatchWidget). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/spatch_widget_bg">
    <ImageView android:id="@+id/frame" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_horizontal" android:padding="16dp">
        <ViewFlipper android:id="@+id/metadata" android:layout_width="wrap_content" android:layout_height="wrap_content" android:inAnimation="@anim/spatch_widget_in" android:outAnimation="@anim/spatch_widget_out" android:measureAllChildren="true">
            <ImageView android:id="@+id/artwork" android:layout_width="140dp" android:layout_height="140dp" android:background="@drawable/spatch_widget_art" android:clipToOutline="true" android:scaleType="centerCrop" android:src="@drawable/spatch_widget_art" android:contentDescription="Album art" />
            <ImageView android:id="@+id/thumbnail" android:layout_width="140dp" android:layout_height="140dp" android:background="@drawable/spatch_widget_art" android:clipToOutline="true" android:scaleType="centerCrop" android:src="@drawable/spatch_widget_art" android:contentDescription="Album art" />
        </ViewFlipper>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal" android:gravity="center_vertical">
            <ViewFlipper android:id="@+id/text_container" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:inAnimation="@anim/spatch_widget_in" android:outAnimation="@anim/spatch_widget_out" android:measureAllChildren="true">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:singleLine="true" android:ellipsize="end" android:textSize="20sp" android:textStyle="bold" android:textColor="#fff3eeff" />
                    <TextView android:id="@+id/subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="center_horizontal" android:singleLine="true" android:ellipsize="end" android:textSize="15sp" android:textColor="#ffbcb3dc" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:id="@+id/title2" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:singleLine="true" android:ellipsize="end" android:textSize="20sp" android:textStyle="bold" android:textColor="#fff3eeff" />
                    <TextView android:id="@+id/subtitle2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="center_horizontal" android:singleLine="true" android:ellipsize="end" android:textSize="15sp" android:textColor="#ffbcb3dc" />
                </LinearLayout>
            </ViewFlipper>
            <LinearLayout android:id="@+id/header" android:layout_width="wrap_content" android:layout_height="14dp" android:layout_marginStart="8dp" android:orientation="horizontal" android:gravity="bottom" android:visibility="gone">
                <ProgressBar android:id="@+id/text1" android:layout_width="3dp" android:layout_height="14dp" android:minWidth="3dp" android:maxWidth="3dp" android:minHeight="14dp" android:maxHeight="14dp" android:layout_marginStart="2dp" android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/spatch_widget_eq" android:indeterminateBehavior="cycle" android:indeterminateDuration="620" />
                <ProgressBar android:id="@+id/text2" android:layout_width="3dp" android:layout_height="14dp" android:minWidth="3dp" android:maxWidth="3dp" android:minHeight="14dp" android:maxHeight="14dp" android:layout_marginStart="2dp" android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/spatch_widget_eq" android:indeterminateBehavior="cycle" android:indeterminateDuration="860" />
                <ProgressBar android:id="@+id/icon_view" android:layout_width="3dp" android:layout_height="14dp" android:minWidth="3dp" android:maxWidth="3dp" android:minHeight="14dp" android:maxHeight="14dp" android:layout_marginStart="2dp" android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/spatch_widget_eq" android:indeterminateBehavior="cycle" android:indeterminateDuration="540" />
                <ProgressBar android:id="@+id/image_view" android:layout_width="3dp" android:layout_height="14dp" android:minWidth="3dp" android:maxWidth="3dp" android:minHeight="14dp" android:maxHeight="14dp" android:layout_marginStart="2dp" android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/spatch_widget_eq" android:indeterminateBehavior="cycle" android:indeterminateDuration="760" />
            </LinearLayout>
        </LinearLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/previous_button" android:stateListAnimator="@animator/spatch_widget_nudge_prev" android:background="@drawable/spatch_widget_skip_prev" android:layout_width="44dp" android:layout_height="44dp" android:padding="8dp" android:src="@android:drawable/ic_media_previous" android:contentDescription="Previous" />
            <FrameLayout android:id="@+id/play_button" android:stateListAnimator="@animator/spatch_widget_press" android:layout_width="60dp" android:layout_height="60dp" android:layout_marginHorizontal="8dp" android:contentDescription="Play or pause">
                <ProgressBar android:id="@+id/image" android:layout_width="match_parent" android:layout_height="match_parent" android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/spatch_widget_to_pause" android:importantForAccessibility="no" />
                <ProgressBar android:id="@+id/spinner" android:layout_width="match_parent" android:layout_height="match_parent" android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/spatch_widget_to_play" android:importantForAccessibility="no" android:visibility="gone" />
                <ImageView android:id="@+id/icon" android:layout_width="26dp" android:layout_height="26dp" android:layout_gravity="center" android:src="@android:drawable/ic_media_play" android:importantForAccessibility="no" />
            </FrameLayout>
            <ImageView android:id="@+id/next_button" android:stateListAnimator="@animator/spatch_widget_nudge_next" android:background="@drawable/spatch_widget_skip_next" android:layout_width="44dp" android:layout_height="44dp" android:padding="8dp" android:src="@android:drawable/ic_media_next" android:contentDescription="Next" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
