<?xml version="1.0" encoding="utf-8"?>
<!-- Old song leaves the widget: fades out while sliding the other way. -->
<set xmlns:android="http://schemas.android.com/apk/res/android" android:interpolator="@android:interpolator/accelerate_cubic" android:duration="200">
    <alpha android:fromAlpha="1" android:toAlpha="0" />
    <translate android:fromXDelta="0" android:toXDelta="-8%" />
</set>
