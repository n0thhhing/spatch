<?xml version="1.0" encoding="utf-8"?>
<!-- Spatch widget, 4x1: blurred-art backdrop; artwork filling the height, title (equaliser while
     playing) and artist, then controls. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/spatch_widget_bg">
    <ImageView android:id="@id/frame" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp">
        <ImageView android:id="@id/artwork" android:layout_width="wrap_content" android:layout_height="match_parent" android:adjustViewBounds="true" android:maxWidth="160dp" android:background="@drawable/spatch_widget_art" android:clipToOutline="true" android:scaleType="centerCrop" android:src="@drawable/spatch_widget_art" android:contentDescription="Album art" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@id/title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:singleLine="true" android:ellipsize="end" android:textSize="15sp" android:textStyle="bold" android:textColor="#fff3eeff" />
                <LinearLayout android:id="@id/header" android:layout_width="wrap_content" android:layout_height="14dp" android:layout_marginStart="8dp" android:orientation="horizontal" android:gravity="bottom" android:visibility="gone">
                <ProgressBar android:id="@id/text1" android:layout_width="3dp" android:layout_height="14dp" android:minWidth="3dp" android:maxWidth="3dp" android:minHeight="14dp" android:maxHeight="14dp" android:layout_marginStart="2dp" android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/spatch_widget_eq" android:indeterminateBehavior="cycle" android:indeterminateDuration="620" />
                <ProgressBar android:id="@id/text2" android:layout_width="3dp" android:layout_height="14dp" android:minWidth="3dp" android:maxWidth="3dp" android:minHeight="14dp" android:maxHeight="14dp" android:layout_marginStart="2dp" android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/spatch_widget_eq" android:indeterminateBehavior="cycle" android:indeterminateDuration="860" />
                <ProgressBar android:id="@id/icon_view" android:layout_width="3dp" android:layout_height="14dp" android:minWidth="3dp" android:maxWidth="3dp" android:minHeight="14dp" android:maxHeight="14dp" android:layout_marginStart="2dp" android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/spatch_widget_eq" android:indeterminateBehavior="cycle" android:indeterminateDuration="540" />
                <ProgressBar android:id="@id/image_view" android:layout_width="3dp" android:layout_height="14dp" android:minWidth="3dp" android:maxWidth="3dp" android:minHeight="14dp" android:maxHeight="14dp" android:layout_marginStart="2dp" android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/spatch_widget_eq" android:indeterminateBehavior="cycle" android:indeterminateDuration="760" />
                </LinearLayout>
            </LinearLayout>
            <TextView android:id="@id/subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:singleLine="true" android:ellipsize="end" android:textSize="13sp" android:textColor="#ffbcb3dc" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@id/previous_button" android:stateListAnimator="@animator/spatch_widget_press" android:layout_width="36dp" android:layout_height="36dp" android:padding="6dp" android:src="@drawable/encore_icon_skip_back_24" android:tint="#fff3eeff" android:contentDescription="Previous" />
            <FrameLayout android:id="@id/play_button" android:stateListAnimator="@animator/spatch_widget_press" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginHorizontal="2dp" android:contentDescription="Play or pause">
                <ProgressBar android:id="@id/image" android:layout_width="match_parent" android:layout_height="match_parent" android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/spatch_widget_to_pause" android:importantForAccessibility="no" />
                <ProgressBar android:id="@id/spinner" android:layout_width="match_parent" android:layout_height="match_parent" android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/spatch_widget_to_play" android:importantForAccessibility="no" android:visibility="gone" />
                <ImageView android:id="@id/icon" android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/encore_icon_play_24" android:tint="#ff14121c" android:importantForAccessibility="no" />
            </FrameLayout>
            <ImageView android:id="@id/next_button" android:stateListAnimator="@animator/spatch_widget_press" android:layout_width="36dp" android:layout_height="36dp" android:padding="6dp" android:src="@drawable/encore_icon_skip_forward_24" android:tint="#fff3eeff" android:contentDescription="Next" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
