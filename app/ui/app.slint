// Spatch's own Spotify UI, inspired by Swiftify: Material 3 Expressive with blurred artwork, scallops,
// squiggles and flowers, coloured by the album art.
import "fonts/Outfit-Bold.ttf";
import "fonts/Outfit-ExtraBold.ttf";
import { Theme, Type } from "theme.slint";
import { Icons } from "icons.slint";
import { Shapes } from "shapes.slint";
import { Icon, IconButton, Art, Row, ListItem, Tile, SectionHeader, QuickCard, WavyProgress, PlayButton, ToggleButton, Flowers, FloatingPlayer, FilterChip, StateLayer } from "components.slint";

export { Theme, Row }

// A horizontally scrolling row of tiles under a squiggle header, running to the screen's edges.
component Carousel inherits VerticalLayout {
    in property <string> title;
    in property <string> icon;
    in property <[Row]> items;
    callback play(string);
    spacing: 8px;
    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        SectionHeader { title: root.title; icon: root.icon; }
    }
    Flickable {
        height: 204px;
        content-width: strip.preferred-width;
        strip := HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            spacing: 14px;
            alignment: start;
            for row in root.items: Tile { item: row; clicked => { root.play(row.uri); } }
        }
    }
}

// Material's emphasized easing, for pages moving in and out.
global Motion {
    out property <duration> page: 420ms;
}

export component AppWindow inherits Window {
    // 0: home, 1: the player, 2: the library.
    in-out property <int> tab;
    in property <string> greeting: "Hello";
    in property <string> track;
    in property <string> artist;
    in property <image> cover;
    // A small copy of the cover, smoothed: stretched, it is the blurred backdrop.
    in property <image> backdrop;
    in property <bool> playing;
    in property <bool> shuffle;
    in property <int> repeat;
    in property <float> progress;
    in property <string> position: "0:00";
    in property <string> remaining: "-0:00";
    in property <[Row]> up-next;
    in property <[Row]> playlists;
    in property <[Row]> albums;
    in property <[Row]> artists;
    in property <[Row]> podcasts;
    // Everything saved, filtered by the library page's chips.
    in property <[Row]> library;
    in-out property <int> library-filter: -1;
    in property <string> library-count;
    in property <string> library-status: "Loading your library…";
    in property <string> status;
    callback toggle();
    callback next();
    callback previous();
    callback seek(float);
    callback shuffle-clicked();
    callback repeat-clicked();
    callback play(string);
    callback liked();
    callback filter-changed(int);
    callback dismiss();
    background: Theme.background;

    // ---- Home ----
    Rectangle {
        Flowers {}
        Flickable {
            content-height: home.preferred-height;
            home := VerticalLayout {
                width: parent.width;
                padding-top: Theme.inset-top + 12px;
                padding-bottom: Theme.inset-bottom + 120px;
                spacing: 22px;

                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    VerticalLayout {
                        spacing: 6px;
                        Text { text: "Spatch"; color: Theme.primary; font-family: Type.display; font-size: 48px; font-weight: 800; }
                        HorizontalLayout {
                            alignment: start;
                            Rectangle {
                                height: 32px;
                                border-radius: 16px;
                                background: Theme.surface-container-high;
                                width: chip.preferred-width;
                                chip := HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 14px;
                                    spacing: 8px;
                                    Path { y: 6px; width: 20px; height: 20px; viewbox-width: 100; viewbox-height: 100; commands: Shapes.cookie; fill: Theme.primary-container; }
                                    Text { text: root.greeting; color: Theme.on-surface-variant; font-size: Type.body-medium; vertical-alignment: center; }
                                }
                            }
                        }
                    }
                    Rectangle {}
                    // Back to Spotify's own screens (sign-in, and anything not rebuilt yet).
                    IconButton { icon: Icons.close; container: Theme.surface-container-high; y: 10px; clicked => { root.dismiss(); } }
                }

                // Now playing, on the blurred cover.
                if root.track != "": HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    Rectangle {
                        height: 200px;
                        border-radius: 32px;
                        clip: true;
                        background: Theme.surface-container;
                        transform-scale: hero.pressed ? 0.98 : 1.0;
                        animate transform-scale { duration: 160ms; easing: ease-out; }
                        Image { width: parent.width; height: parent.height; source: root.backdrop; image-fit: fill; }
                        Rectangle { background: Theme.surface-container.with-alpha(0.6); }
                        hero := TouchArea { clicked => { root.tab = 1; } }
                        HorizontalLayout {
                            padding: 18px;
                            spacing: 18px;
                            Rectangle {
                                width: 132px;
                                height: 132px;
                                y: 16px;
                                border-radius: 22px;
                                drop-shadow-blur: 18px;
                                drop-shadow-offset-y: 6px;
                                drop-shadow-color: #00000070;
                                Art { border-radius: 22px; source: root.cover; }
                            }
                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                Text { text: "NOW PLAYING"; color: Theme.primary; font-size: 11px; font-weight: 800; letter-spacing: 1.6px; }
                                Text { text: root.track; color: Theme.on-primary-container; font-family: Type.display; font-size: 26px; font-weight: 800; overflow: elide; }
                                Text { text: root.artist; color: Theme.on-surface-variant; font-size: Type.body-large; overflow: elide; }
                                Rectangle { height: 4px; }
                                HorizontalLayout {
                                    spacing: 10px;
                                    alignment: start;
                                    PlayButton { playing: root.playing; size: 52px; clicked => { root.toggle(); } }
                                    Text { text: root.playing ? "Pause" : "Play"; color: Theme.on-surface; font-family: Type.display; font-size: 17px; font-weight: 700; vertical-alignment: center; }
                                }
                                WavyProgress { height: 14px; thickness: 2.5px; progress: root.progress; playing: root.playing; seekable: false; }
                            }
                        }
                    }
                }

                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    spacing: 12px;
                    QuickCard { icon: Icons.favorite; title: "Liked Songs"; subtitle: "Your favourites"; clicked => { root.liked(); } }
                    QuickCard { icon: Icons.library; title: "Your Library"; subtitle: root.library-count; clicked => { root.tab = 2; } }
                }

                if root.library-status != "": HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    Text { text: root.library-status; color: Theme.on-surface-variant; font-size: Type.body-medium; wrap: word-wrap; }
                }
                if root.playlists.length > 0: Carousel { title: "Playlists"; icon: Icons.library; items: root.playlists; play(uri) => { root.play(uri); } }
                if root.albums.length > 0: Carousel { title: "Albums"; icon: Icons.album; items: root.albums; play(uri) => { root.play(uri); } }
                if root.artists.length > 0: Carousel { title: "Artists"; icon: Icons.favorite; items: root.artists; play(uri) => { root.play(uri); } }
                if root.podcasts.length > 0: Carousel { title: "Podcasts"; icon: Icons.album; items: root.podcasts; play(uri) => { root.play(uri); } }
            }
        }
    }

    // ---- The library: slides in from the right ----
    Rectangle {
        x: root.tab == 2 ? 0px : root.width;
        animate x { duration: Motion.page; easing: cubic-bezier(0.2, 0, 0, 1); }
        visible: self.x < root.width;
        width: root.width;
        background: Theme.background;
        TouchArea {} // nothing underneath takes touches
        VerticalLayout {
            padding-top: Theme.inset-top + 8px;
            spacing: 8px;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 20px;
                spacing: 8px;
                IconButton { icon: Icons.back; content: Theme.on-surface; size: 48px; clicked => { root.tab = 0; } }
                Text { text: "Your Library"; color: Theme.on-surface; font-family: Type.display; font-size: 28px; font-weight: 800; vertical-alignment: center; }
            }
            Flickable {
                height: 48px;
                content-width: chips.preferred-width;
                chips := HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    padding-top: 6px;
                    padding-bottom: 6px;
                    spacing: 8px;
                    alignment: start;
                    FilterChip { label: "Playlists"; selected: root.library-filter == 0; clicked => { root.library-filter = root.library-filter == 0 ? -1 : 0; root.filter-changed(root.library-filter); } }
                    FilterChip { label: "Albums"; selected: root.library-filter == 1; clicked => { root.library-filter = root.library-filter == 1 ? -1 : 1; root.filter-changed(root.library-filter); } }
                    FilterChip { label: "Artists"; selected: root.library-filter == 2; clicked => { root.library-filter = root.library-filter == 2 ? -1 : 2; root.filter-changed(root.library-filter); } }
                    FilterChip { label: "Podcasts"; selected: root.library-filter == 3; clicked => { root.library-filter = root.library-filter == 3 ? -1 : 3; root.filter-changed(root.library-filter); } }
                }
            }
            // shortcut: every row is built up front; fine for a few hundred, switch to a virtualised list for more.
            Flickable {
                vertical-stretch: 1;
                content-height: list.preferred-height;
                list := VerticalLayout {
                    width: parent.width;
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-bottom: Theme.inset-bottom + 110px;
                    for row in root.library: ListItem { item: row; clicked => { root.play(row.uri); } }
                }
            }
        }
    }

    // A fade behind the floating player so content slips under it.
    if root.track != "" && root.tab != 1: Rectangle {
        y: root.height - Theme.inset-bottom - 130px;
        height: Theme.inset-bottom + 130px;
        background: @linear-gradient(180deg, transparent 0%, Theme.background.with-alpha(0.92) 60%, Theme.background 100%);
    }

    if root.track != "" && root.tab != 1: FloatingPlayer {
        x: 12px;
        y: root.height - Theme.inset-bottom - self.height - 12px;
        width: root.width - 24px;
        cover: root.cover;
        track: root.track;
        artist: root.artist;
        playing: root.playing;
        progress: root.progress;
        toggle => { root.toggle(); }
        next => { root.next(); }
        open => { root.tab = 1; }
    }

    // ---- The player: immersive, sliding up over the rest ----
    Rectangle {
        y: root.tab == 1 ? 0px : root.height;
        animate y { duration: Motion.page; easing: cubic-bezier(0.2, 0, 0, 1); }
        visible: self.y < root.height;
        height: root.height;
        background: Theme.background;
        clip: true;
        Image { width: parent.width; height: parent.height; source: root.backdrop; image-fit: fill; }
        Rectangle { background: Theme.background.with-alpha(0.5); }
        Flowers { tint: Theme.on-surface; }
        TouchArea {} // nothing underneath takes touches

        Flickable {
            content-height: player.preferred-height;
            player := VerticalLayout {
                width: parent.width;
                padding-left: 28px;
                padding-right: 28px;
                padding-top: Theme.inset-top + 8px;
                padding-bottom: Theme.inset-bottom + 24px;
                spacing: 0px;
                HorizontalLayout {
                    IconButton { icon: Icons.close; container: Theme.on-surface.with-alpha(0.12); content: Theme.on-surface; clicked => { root.tab = 0; } }
                    Rectangle {}
                    Text { text: "NOW PLAYING"; color: Theme.on-surface-variant; font-size: 11px; font-weight: 800; letter-spacing: 1.6px; vertical-alignment: center; }
                    Rectangle {}
                    Rectangle { width: 40px; }
                }
                Rectangle { height: 20px; }
                // The cover in a circle, ringed by a fine wave.
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: min(parent.width - 16px, 320px);
                        height: self.width;
                        Path {
                            width: parent.width;
                            height: parent.height;
                            viewbox-width: 100;
                            viewbox-height: 100;
                            commands: Shapes.wavy-ring;
                            stroke: Theme.primary;
                            stroke-width: 3px;
                            fill: transparent;
                        }
                        Rectangle {
                            x: 16px;
                            y: 16px;
                            width: parent.width - 32px;
                            height: self.width;
                            border-radius: self.width / 2;
                            drop-shadow-blur: 30px;
                            drop-shadow-color: Theme.primary.with-alpha(0.3);
                            Art { border-radius: parent.width / 2; source: root.cover; }
                        }
                    }
                }
                Rectangle { height: 32px; }
                Text { text: root.track != "" ? root.track : "Nothing playing"; horizontal-alignment: center; color: Theme.on-surface; font-family: Type.display; font-size: 30px; font-weight: 800; overflow: elide; }
                Rectangle { height: 6px; }
                Text { text: root.artist; horizontal-alignment: center; color: Theme.on-surface-variant; font-size: Type.body-large; overflow: elide; }
                Rectangle { height: 24px; }
                HorizontalLayout {
                    spacing: 12px;
                    Text { text: root.position; color: Theme.on-surface-variant; font-size: Type.label-medium; vertical-alignment: center; }
                    WavyProgress { progress: root.progress; playing: root.playing; played: Theme.on-surface; seek(f) => { root.seek(f); } }
                    Text { text: root.remaining; color: Theme.on-surface-variant; font-size: Type.label-medium; vertical-alignment: center; }
                }
                Rectangle { height: 16px; }
                HorizontalLayout {
                    alignment: space-between;
                    ToggleButton { icon: Icons.shuffle; active: root.shuffle; idle: Theme.on-surface; y: 18px; clicked => { root.shuffle-clicked(); } }
                    IconButton { icon: Icons.skip-previous; size: 56px; icon-size: 32px; y: 18px; content: Theme.on-surface; clicked => { root.previous(); } }
                    PlayButton { playing: root.playing; size: 92px; fill: Theme.on-surface; ink: Theme.background; clicked => { root.toggle(); } }
                    IconButton { icon: Icons.skip-next; size: 56px; icon-size: 32px; y: 18px; content: Theme.on-surface; clicked => { root.next(); } }
                    ToggleButton { icon: Icons.repeat; active: root.repeat > 0; badge: root.repeat == 2 ? "1" : ""; idle: Theme.on-surface; y: 18px; clicked => { root.repeat-clicked(); } }
                }
                Rectangle { height: 28px; }
                if root.up-next.length > 0: Rectangle {
                    border-radius: 28px;
                    background: Theme.surface-container.with-alpha(0.7);
                    height: queue.preferred-height;
                    queue := VerticalLayout {
                        padding: 16px;
                        padding-bottom: 8px;
                        Text { text: "Up next"; color: Theme.on-surface; font-family: Type.display; font-size: 18px; font-weight: 800; }
                        for row in root.up-next: ListItem { item: row; }
                    }
                }
                if root.status != "": Text { text: root.status; color: Theme.on-surface-variant; font-size: Type.label-medium; wrap: word-wrap; }
            }
        }
    }
}
