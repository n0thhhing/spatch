// Spatch's own Spotify UI: Material 3 Expressive, the Pixel look, coloured by the Spatch theme.
import { Theme, Type } from "theme.slint";
import { Icons } from "icons.slint";
import { Icon, IconButton, Art, Row, ListItem, FilterChip, NavItem, WavyProgress, PlayButton, MiniPlayer, ToggleButton } from "components.slint";

export { Theme, Row }

export component AppWindow inherits Window {
    in-out property <int> tab;
    in property <string> track: "Nothing playing";
    in property <string> artist;
    in property <image> cover;
    // A 12x12 copy of the cover: stretched over the screen it is the blurred backdrop.
    in property <image> backdrop;
    in property <bool> shuffle;
    in property <int> repeat;
    in property <bool> playing;
    in property <float> progress;
    in property <string> position: "0:00";
    in property <string> duration: "0:00";
    in property <[Row]> up-next;
    in property <[Row]> library;
    in-out property <int> library-filter: -1;
    in property <string> library-status: "Loading your library…";
    in property <string> status;
    callback toggle();
    callback next();
    callback previous();
    callback seek(float);
    callback shuffle-clicked();
    callback repeat-clicked();
    callback play(string);
    callback library-opened();
    callback filter-changed(int);
    callback dismiss();
    background: Theme.background;
    property <length> top-bar: Theme.inset-top + 64px;
    property <length> nav-bar: 80px + Theme.inset-bottom;
    // The mini player rides above the navigation bar off the player page.
    property <length> mini: root.tab == 0 ? 0px : 76px;

    // Spatch's player backdrop: the cover blurred across the whole screen (a tiny copy scaled up
    // smoothly), dimmed so text stays readable and fading into the page at the bottom.
    if root.tab == 0: Rectangle {
        Image { width: parent.width; height: parent.height; source: root.backdrop; image-fit: fill; image-rendering: smooth; }
        Rectangle { background: Theme.background.with-alpha(0.6); }
        Rectangle { background: @linear-gradient(180deg, transparent 0%, transparent 45%, Theme.background 100%); }
    }

    // Three bands placed outright (top bar, pages, navigation bar): a layout let the shorter page cap the height.
    Rectangle {
        // Top app bar: the page's title, Close back to Spotify's own UI.
        y: 0;
        height: root.top-bar;
        HorizontalLayout {
            padding-top: Theme.inset-top + 8px;
            padding-left: 16px;
            padding-right: 8px;
            padding-bottom: 8px;
            Text {
                text: root.tab == 0 ? "Now playing" : "Library";
                color: Theme.on-surface;
                font-size: Type.headline-medium;
                vertical-alignment: center;
            }
            Rectangle {}
            IconButton { icon: Icons.close; y: (parent.height - Theme.inset-top - self.height) / 2; clicked => { root.dismiss(); } }
        }
    }

        // Both pages stay built and fill the space between the bars; the tab shows one.
        Rectangle {
        y: root.top-bar;
        height: root.height - root.top-bar - root.nav-bar - root.mini;
        Flickable {
            visible: root.tab == 0;
            width: parent.width;
            height: parent.height;
            content-height: page.preferred-height;
            page := VerticalLayout {
                width: parent.width;
                padding-left: 24px;
                padding-right: 24px;
                padding-top: 8px;
                padding-bottom: 16px;
                spacing: 0px;
                // Spatch's round artwork, with a soft ring in the cover's accent.
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: min(parent.width, 340px);
                        height: self.width;
                        border-radius: self.width / 2;
                        border-width: 2px;
                        border-color: Theme.primary.with-alpha(0.45);
                        drop-shadow-blur: 32px;
                        drop-shadow-color: Theme.primary.with-alpha(0.25);
                        Art {
                            x: 10px;
                            y: 10px;
                            width: parent.width - 20px;
                            height: self.width;
                            border-radius: self.width / 2;
                            source: root.cover;
                        }
                    }
                }
                Rectangle { height: 28px; }
                // The title leans towards the cover's colour, as Spatch's does.
                Text { text: root.track; color: Theme.on-surface.mix(Theme.primary, 0.7); font-size: Type.title-large + 4px; font-weight: 700; overflow: elide; }
                Rectangle { height: 4px; }
                Text { text: root.artist; color: Theme.on-surface-variant; font-size: Type.body-large; overflow: elide; }
                Rectangle { height: 20px; }
                // Spatch's controls card: the wavy seek bar over shuffle, previous, play, next and repeat.
                Rectangle {
                    border-radius: 32px;
                    background: Theme.surface-container.with-alpha(0.78);
                    height: card.preferred-height;
                    card := VerticalLayout {
                        padding: 20px;
                        padding-bottom: 12px;
                        spacing: 4px;
                        WavyProgress { progress: root.progress; playing: root.playing; seek(f) => { root.seek(f); } }
                        HorizontalLayout {
                            Text { text: root.position; color: Theme.on-surface-variant; font-size: Type.label-medium; }
                            Rectangle {}
                            Text { text: root.duration; color: Theme.on-surface-variant; font-size: Type.label-medium; }
                        }
                        HorizontalLayout {
                            alignment: space-between;
                            ToggleButton { icon: Icons.shuffle; active: root.shuffle; y: 16px; clicked => { root.shuffle-clicked(); } }
                            IconButton { icon: Icons.skip-previous; size: 56px; icon-size: 32px; y: 16px; content: Theme.on-surface; clicked => { root.previous(); } }
                            PlayButton { playing: root.playing; clicked => { root.toggle(); } }
                            IconButton { icon: Icons.skip-next; size: 56px; icon-size: 32px; y: 16px; content: Theme.on-surface; clicked => { root.next(); } }
                            ToggleButton { icon: Icons.repeat; active: root.repeat > 0; badge: root.repeat == 2 ? "1" : ""; y: 16px; clicked => { root.repeat-clicked(); } }
                        }
                    }
                }
                Rectangle { height: 28px; }
                if root.up-next.length > 0: Text {
                    text: "Up next";
                    color: Theme.on-surface;
                    font-size: Type.title-medium;
                    font-weight: 600;
                }
                if root.up-next.length > 0: Rectangle { height: 8px; }
                if root.up-next.length > 0: Rectangle {
                    border-radius: 24px;
                    background: Theme.surface-container;
                    clip: true;
                    height: col.preferred-height;
                    col := VerticalLayout {
                        padding-top: 8px;
                        padding-bottom: 8px;
                        for row in root.up-next: ListItem { item: row; }
                    }
                }
                if root.status != "": Text {
                    text: root.status;
                    color: Theme.on-surface-variant;
                    font-size: Type.label-medium;
                    wrap: word-wrap;
                }
            }
        }

        VerticalLayout {
            visible: root.tab == 1;
            width: parent.width;
            height: parent.height;
            // The chip row scrolls sideways when it's wider than the screen, as on Pixel.
            Flickable {
                height: 48px;
                content-width: chips.preferred-width;
                chips := HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-bottom: 8px;
                spacing: 8px;
                alignment: start;
                FilterChip { label: "Playlists"; selected: root.library-filter == 0; clicked => { root.library-filter = root.library-filter == 0 ? -1 : 0; root.filter-changed(root.library-filter); } }
                FilterChip { label: "Albums"; selected: root.library-filter == 1; clicked => { root.library-filter = root.library-filter == 1 ? -1 : 1; root.filter-changed(root.library-filter); } }
                FilterChip { label: "Artists"; selected: root.library-filter == 2; clicked => { root.library-filter = root.library-filter == 2 ? -1 : 2; root.filter-changed(root.library-filter); } }
                FilterChip { label: "Podcasts"; selected: root.library-filter == 3; clicked => { root.library-filter = root.library-filter == 3 ? -1 : 3; root.filter-changed(root.library-filter); } }
                }
            }
            if root.library-status != "": Text {
                x: 16px;
                text: root.library-status;
                color: Theme.on-surface-variant;
                font-size: Type.body-medium;
                wrap: word-wrap;
            }
            // shortcut: every row is built up front; fine for a few hundred, switch to a virtualised list for more.
            Flickable {
                vertical-stretch: 1;
                content-height: list.preferred-height;
                list := VerticalLayout {
                    width: parent.width;
                    for row in root.library: ListItem { item: row; clicked => { root.play(row.uri); } }
                }
            }
        }

        }

        if root.tab != 0: MiniPlayer {
            x: 12px;
            y: root.height - root.nav-bar - 72px;
            width: root.width - 24px;
            cover: root.cover;
            track: root.track;
            artist: root.artist;
            playing: root.playing;
            progress: root.progress;
            toggle => { root.toggle(); }
            open => { root.tab = 0; }
        }

        // M3 navigation bar.
        Rectangle {
            y: root.height - root.nav-bar;
            height: root.nav-bar;
            background: Theme.surface-container;
            HorizontalLayout {
                padding-top: 12px;
                padding-bottom: Theme.inset-bottom + 16px;
                NavItem { icon: Icons.album; label: "Now playing"; selected: root.tab == 0; clicked => { root.tab = 0; } }
                NavItem { icon: Icons.library; label: "Library"; selected: root.tab == 1; clicked => { root.tab = 1; root.library-opened(); } }
            }
        }
}
