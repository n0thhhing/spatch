// Material 3 roles for the app, filled from the running Spatch theme at open (ui.rs).
export global Theme {
    in-out property <color> background: #141218;
    in-out property <color> surface-container: #1d1a2a;
    in-out property <color> surface-container-high: #2b2640;
    in-out property <color> surface-container-highest: #36304d;
    in-out property <color> on-surface: #f3eeff;
    in-out property <color> on-surface-variant: #bcb3dc;
    in-out property <color> primary: #d0bcff;
    in-out property <color> on-primary: #381e72;
    in-out property <color> primary-container: #4f378b;
    in-out property <color> on-primary-container: #eaddff;
    in-out property <color> secondary-container: #4a4458;
    in-out property <color> on-secondary-container: #e8def8;
    in-out property <color> outline: #938f99;
    in-out property <color> outline-variant: #49454f;
    // Safe areas in logical px: the status bar above, the gesture bar below.
    in-out property <length> inset-top: 32px;
    in-out property <length> inset-bottom: 16px;
}

// M3 type scale (sp == px here: Slint's scale factor is the screen density).
export global Type {
    out property <length> headline-medium: 28px;
    out property <length> title-large: 22px;
    out property <length> title-medium: 16px;
    out property <length> body-large: 16px;
    out property <length> body-medium: 14px;
    out property <length> label-large: 14px;
    out property <length> label-medium: 12px;
}
