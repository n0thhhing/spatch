// Components for the app, inspired by Swiftify's look (Material 3 Expressive, end4-style): scallop
// buttons, squiggle section headers, cookie icon tiles, blurred-art cards and a floating player.
import { Theme, Type } from "theme.slint";
import { Icons } from "icons.slint";
import { Shapes } from "shapes.slint";

// A Material Symbol (24px grid, 960 units).
export component Icon inherits Path {
    in property <string> icon;
    in property <length> size: 24px;
    width: root.size;
    height: root.size;
    viewbox-x: 0;
    viewbox-y: -960;
    viewbox-width: 960;
    viewbox-height: 960;
    commands: root.icon;
    fill: Theme.on-surface;
    stroke-width: 0;
}

// Pressed-state layer (M3: the content colour at 10%).
export component StateLayer inherits Rectangle {
    in property <bool> pressed;
    in property <color> tint: Theme.on-surface;
    background: root.pressed ? root.tint.with-alpha(0.10) : transparent;
    animate background { duration: 120ms; }
}

// A round icon button: 40px target, 24px icon, optionally on a container.
export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <length> size: 40px;
    in property <length> icon-size: 24px;
    in property <color> container: transparent;
    in property <color> content: Theme.on-surface-variant;
    callback clicked();
    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: root.container;
    clip: true;
    StateLayer { pressed: touch.pressed; tint: root.content; }
    Icon { icon: root.icon; size: root.icon-size; fill: root.content; }
    touch := TouchArea { clicked => { root.clicked(); } }
}

// Artwork with the theme's container behind it while it loads.
export component Art inherits Rectangle {
    in property <image> source;
    background: Theme.surface-container-high;
    clip: true;
    Image { width: parent.width; height: parent.height; source: root.source; image-fit: cover; }
}

export struct Row { title: string, subtitle: string, art: image, uri: string, round: bool }

// A two-line row (Up next): 64px, rounded artwork.
export component ListItem inherits Rectangle {
    in property <Row> item;
    callback clicked();
    height: 64px;
    StateLayer { pressed: touch.pressed; }
    HorizontalLayout {
        padding-left: 4px;
        padding-right: 8px;
        spacing: 14px;
        alignment: start;
        Art { width: 48px; height: 48px; y: 8px; border-radius: root.item.round ? 24px : 12px; source: root.item.art; }
        VerticalLayout {
            alignment: center;
            Text { text: root.item.title; color: Theme.on-surface; font-size: Type.body-large; font-weight: 600; overflow: elide; }
            Text { text: root.item.subtitle; color: Theme.on-surface-variant; font-size: Type.body-medium; overflow: elide; }
        }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

// A cover tile for the carousels: artwork (round for artists) with the name under it.
export component Tile inherits Rectangle {
    in property <Row> item;
    in property <length> size: 152px;
    callback clicked();
    width: root.size;
    height: root.size + 52px;
    Rectangle {
        y: 0;
        height: root.size;
        border-radius: root.item.round ? root.size / 2 : 20px;
        clip: true;
        transform-scale: touch.pressed ? 0.95 : 1.0;
        animate transform-scale { duration: 160ms; easing: ease-out; }
        Art { source: root.item.art; }
    }
    VerticalLayout {
        y: root.size + 8px;
        height: 44px;
        Text {
            text: root.item.title;
            color: Theme.on-surface;
            font-size: Type.body-large;
            font-weight: 600;
            overflow: elide;
            horizontal-alignment: root.item.round ? center : left;
        }
        Text {
            text: root.item.subtitle;
            color: Theme.on-surface-variant;
            font-size: Type.label-medium;
            overflow: elide;
            horizontal-alignment: root.item.round ? center : left;
        }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

// A section header: a cookie badge, the title, then a squiggle running to the edge.
export component SectionHeader inherits Rectangle {
    in property <string> title;
    in property <string> icon;
    height: 48px;
    HorizontalLayout {
        spacing: 12px;
        Rectangle {
            width: 32px;
            Path {
                y: 8px;
                width: 32px;
                height: 32px;
                viewbox-width: 100;
                viewbox-height: 100;
                commands: Shapes.cookie;
                fill: Theme.secondary-container;
            }
            Icon { y: 15px; icon: root.icon; size: 18px; fill: Theme.on-secondary-container; }
        }
        Text { text: root.title; color: Theme.on-surface; font-family: Type.display; font-size: Type.title-large + 2px; font-weight: 800; vertical-alignment: center; }
        Rectangle {
            horizontal-stretch: 1;
            Path {
                y: (parent.height - 10px) / 2;
                width: parent.width;
                height: 10px;
                viewbox-x: 0;
                viewbox-y: -10;
                viewbox-width: 1000;
                viewbox-height: 20;
                commands: Shapes.squiggle;
                stroke: Theme.outline-variant;
                stroke-width: 1.5px;
                fill: transparent;
            }
        }
    }
}

// A quick card: an icon in a cookie, a title and a line, and a chevron.
export component QuickCard inherits Rectangle {
    in property <string> icon;
    in property <string> title;
    in property <string> subtitle;
    callback clicked();
    height: 76px;
    border-radius: 24px;
    background: Theme.surface-container-high;
    clip: true;
    StateLayer { pressed: touch.pressed; }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 10px;
        Rectangle {
            width: 40px;
            Path {
                y: 18px;
                width: 40px;
                height: 40px;
                viewbox-width: 100;
                viewbox-height: 100;
                commands: Shapes.cookie;
                fill: Theme.primary-container;
            }
            Icon { y: 26px; icon: root.icon; size: 22px; fill: Theme.on-primary-container; }
        }
        VerticalLayout {
            alignment: center;
            Text { text: root.title; color: Theme.on-surface; font-family: Type.display; font-size: 16px; font-weight: 700; overflow: elide; }
            Text { text: root.subtitle; color: Theme.on-surface-variant; font-size: Type.label-medium; overflow: elide; }
        }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

// The wavy seek bar: the played part waves while playing, the rest is a flat track. Tap to seek.
export component WavyProgress inherits Rectangle {
    in property <float> progress;
    in property <bool> playing;
    in property <color> played: Theme.primary;
    in property <color> track: Theme.on-surface.with-alpha(0.18);
    in property <length> thickness: 4px;
    in property <bool> seekable: true;
    callback seek(float);
    height: 24px;
    property <length> at: root.width * clamp(root.progress, 0, 1);
    Rectangle {
        x: root.at + 6px;
        y: (root.height - self.height) / 2;
        width: max(0px, root.width - root.at - 6px);
        height: root.thickness;
        border-radius: root.thickness / 2;
        background: root.track;
    }
    Rectangle {
        x: 0; // children without an x are centred
        width: root.at;
        clip: true;
        if root.playing: Path {
            x: 0;
            width: root.width;
            height: root.height;
            viewbox-x: 0;
            viewbox-y: -10;
            viewbox-width: 1000;
            viewbox-height: 20;
            commands: Shapes.squiggle;
            stroke: root.played;
            stroke-width: root.thickness;
            stroke-line-cap: round;
            fill: transparent;
        }
        if !root.playing: Rectangle { y: (root.height - root.thickness) / 2; height: root.thickness; border-radius: root.thickness / 2; background: root.played; }
    }
    if root.seekable: TouchArea { clicked => { root.seek(self.mouse-x / self.width); } }
}

// The scallop play button: five lobes while paused, nine while playing, turning as it changes.
export component PlayButton inherits Rectangle {
    in property <bool> playing;
    in property <length> size: 88px;
    in property <color> fill: Theme.primary;
    in property <color> ink: Theme.on-primary;
    callback clicked();
    width: root.size;
    height: root.size;
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 100;
        viewbox-height: 100;
        commands: root.playing ? Shapes.scallop9 : Shapes.scallop5;
        fill: root.fill;
        stroke-width: 0;
        transform-rotation: root.playing ? 36deg : 0deg;
        transform-scale: touch.pressed ? 0.9 : 1.0;
        animate transform-rotation { duration: 450ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
        animate transform-scale { duration: 160ms; easing: ease-out; }
    }
    Icon { icon: root.playing ? Icons.pause : Icons.play; size: root.size * 0.42; fill: root.ink; }
    touch := TouchArea { clicked => { root.clicked(); } }
}

// A two-state control (shuffle, repeat): the accent and a dot when on.
export component ToggleButton inherits Rectangle {
    in property <string> icon;
    in property <bool> active;
    in property <string> badge;
    in property <color> idle: Theme.on-surface-variant;
    callback clicked();
    width: 48px;
    height: 56px;
    Rectangle {
        y: 4px;
        width: 44px;
        height: 44px;
        border-radius: 22px;
        clip: true;
        StateLayer { pressed: touch.pressed; tint: root.active ? Theme.primary : root.idle; }
        Icon { icon: root.icon; fill: root.active ? Theme.primary : root.idle; }
        if root.badge != "": Text { x: 28px; y: 6px; text: root.badge; font-size: 10px; font-weight: 800; color: Theme.primary; }
    }
    Rectangle { y: 50px; width: 4px; height: 4px; border-radius: 2px; background: root.active ? Theme.primary : transparent; }
    touch := TouchArea { clicked => { root.clicked(); } }
}

// Faint flower shapes drifting behind a page, as in Swiftify's backdrops.
export component Flowers inherits Rectangle {
    in property <color> tint: Theme.primary;
    Path { x: -70px; y: 40px; width: 260px; height: 260px; viewbox-width: 100; viewbox-height: 100; commands: Shapes.flower; fill: root.tint.with-alpha(0.06); transform-rotation: 12deg; }
    Path { x: parent.width - 150px; y: parent.height * 0.45; width: 300px; height: 300px; viewbox-width: 100; viewbox-height: 100; commands: Shapes.flower; fill: root.tint.with-alpha(0.05); transform-rotation: -20deg; }
    Path { x: parent.width * 0.35; y: parent.height - 160px; width: 220px; height: 220px; viewbox-width: 100; viewbox-height: 100; commands: Shapes.cookie; fill: root.tint.with-alpha(0.05); }
}

// The floating player pill: artwork, the song, play/pause and next, the progress along its foot.
export component FloatingPlayer inherits Rectangle {
    in property <image> cover;
    in property <string> track;
    in property <string> artist;
    in property <bool> playing;
    in property <float> progress;
    callback toggle();
    callback next();
    callback open();
    height: 76px;
    border-radius: 28px;
    background: Theme.surface-container-highest;
    drop-shadow-blur: 24px;
    drop-shadow-offset-y: 6px;
    drop-shadow-color: #00000080;
    clip: true;
    StateLayer { pressed: touch.pressed; }
    touch := TouchArea { clicked => { root.open(); } }
    HorizontalLayout {
        padding: 10px;
        padding-right: 8px;
        spacing: 12px;
        Art { width: 52px; height: 52px; border-radius: 14px; source: root.cover; }
        VerticalLayout {
            alignment: center;
            Text { text: root.track; color: Theme.on-surface; font-size: Type.body-large; font-weight: 700; overflow: elide; }
            Text { text: root.artist; color: Theme.on-surface-variant; font-size: Type.body-medium; overflow: elide; }
        }
        PlayButton { playing: root.playing; size: 52px; y: 2px; clicked => { root.toggle(); } }
        IconButton { icon: Icons.skip-next; size: 44px; y: 6px; content: Theme.on-surface; clicked => { root.next(); } }
    }
    WavyProgress {
        x: 74px;
        y: parent.height - 14px;
        width: parent.width - 96px;
        height: 10px;
        thickness: 2.5px;
        progress: root.progress;
        playing: root.playing;
        seekable: false;
    }
}

// A filter chip: outlined, filled with a check when selected.
export component FilterChip inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked();
    height: 36px;
    border-radius: 18px;
    border-width: root.selected ? 0px : 1px;
    border-color: Theme.outline-variant;
    background: root.selected ? Theme.secondary-container : transparent;
    animate background { duration: 150ms; }
    clip: true;
    StateLayer { pressed: touch.pressed; tint: root.selected ? Theme.on-secondary-container : Theme.on-surface-variant; }
    HorizontalLayout {
        padding-left: root.selected ? 10px : 16px;
        padding-right: 16px;
        spacing: 6px;
        if root.selected: Icon { icon: Icons.check; size: 18px; y: 9px; fill: Theme.on-secondary-container; }
        Text { text: root.label; vertical-alignment: center; font-size: Type.label-large; font-weight: 600; color: root.selected ? Theme.on-secondary-container : Theme.on-surface-variant; }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}
