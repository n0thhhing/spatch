// A soft field of four colours (the player's "Flowing" backdrop: one per quarter of the cover; a playlist header: four
// tints of its colours), slowly drifting and folding into itself.
// shade 1 darkens it toward the page colour like the player's scrim (40% at the top, 60% by 45% down, solid at the
// foot); 2 fades it fully into the page colour by the bottom edge, for a header wash. Fine grain breaks up banding.
uniform float2 size;
uniform float time;
uniform float shade;
layout(color) uniform half4 c0;
layout(color) uniform half4 c1;
layout(color) uniform half4 c2;
layout(color) uniform half4 c3;
layout(color) uniform half4 base;
float hash(float2 p) { return fract(sin(dot(p, float2(12.9898, 78.233))) * 43758.5453); }
float pool(float2 q, float2 at) { float2 d = q - at; return exp(-6.0 * dot(d, d)); }
half4 main(float2 p) {
  float ax = size.x / size.y;
  float2 uv = p / size.y;
  float t = time;
  float2 q = uv + 0.07 * float2(sin(uv.y * 3.7 + t * 0.53), sin(uv.x * 4.1 - t * 0.41));
  float w0 = pool(q, float2(ax * (0.22 + 0.12 * sin(t * 0.21)), 0.16 + 0.09 * cos(t * 0.17)));
  float w1 = pool(q, float2(ax * (0.80 + 0.10 * cos(t * 0.19)), 0.24 + 0.10 * sin(t * 0.23)));
  float w2 = pool(q, float2(ax * (0.26 + 0.11 * cos(t * 0.15)), 0.62 + 0.11 * sin(t * 0.20)));
  float w3 = pool(q, float2(ax * (0.78 + 0.12 * sin(t * 0.13)), 0.74 + 0.09 * cos(t * 0.18)));
  half3 col = (c0.rgb * w0 + c1.rgb * w1 + c2.rgb * w2 + c3.rgb * w3) / (w0 + w1 + w2 + w3 + 0.0001);
  half lum = dot(col, half3(0.2126, 0.7152, 0.0722));
  col = clamp(mix(half3(lum), col, 1.3), 0.0, 1.0);
  float y = p.y / size.y;
  float a = shade > 1.5 ? pow(y, 1.2) : (y < 0.45 ? mix(0.4, 0.6, y / 0.45) : mix(0.6, 1.0, (y - 0.45) / 0.55));
  col = mix(col, base.rgb, a);
  col += (hash(p) - 0.5) / 255.0;
  return half4(col, 1.0);
}
