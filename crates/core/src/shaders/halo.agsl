// Player disc aura: two offset OLED-dithered dual-colour radial pools behind the cover, breathing gently with bass.
uniform float2 center;
uniform float4 params; // x = radius, y = breath, z = unused, w = dark (1 or 0)
layout(color) uniform half4 a;
layout(color) uniform half4 b;

float hash(float2 p) { return fract(sin(dot(p, float2(12.9898, 78.233))) * 43758.5453); }

half4 main(float2 p) {
  float r = max(params.x, 1.0);
  float2 d = p - center;
  if (length(d) >= r) return half4(0.0);
  float breath = clamp(params.y, 0.0, 1.0);
  float2 off = float2(r * 0.10, r * 0.06);
  float poolR = max(r - length(off), 1.0);
  float da = length(d - float2(-off.x, off.y)) / poolR;
  float db = length(d - float2(off.x, -off.y)) / poolR;
  float ta = 1.0 - smoothstep(0.0, 1.0, da);
  float tb = 1.0 - smoothstep(0.0, 1.0, db);
  float gain = (params.w > 0.5 ? 1.0 : 0.72) * (1.0 + breath * 0.35);
  float aa = ta * ta * ta * 0.30 * gain;
  float ab = tb * tb * tb * 0.23 * gain;
  float outA = aa + ab * (1.0 - aa);
  if (outA <= 0.0005) return half4(0.0);
  half3 col = (a.rgb * aa + b.rgb * (ab * (1.0 - aa))) / outA;
  col = clamp(col + (hash(p) - 0.5) / 255.0, 0.0, 1.0);
  return half4(col * outA, outA);
}
